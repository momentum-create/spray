{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack enable && corepack prepare pnpm@9.15.0 --activate && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @spray/web build",
  "framework": "nextjs",
  "outputDirectory": "apps/web/.next",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "spray166.com" }],
      "destination": "https://www.spray166.com/:path*",
      "permanent": true
    }
  ]
}
