#!/usr/bin/env sh
# origin/main へ push したあと、Vercel 用に seeker/main へミラーする
remote="$1"
branch=$(git symbolic-ref -q HEAD 2>/dev/null | sed 's|^refs/heads/||')

if [ "$remote" != "origin" ] || [ "$branch" != "main" ]; then
  exit 0
fi

echo "→ mirroring main to seeker (Vercel)..."
if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/push-seeker.ps1
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File scripts/push-seeker.ps1
else
  echo "✗ push-seeker.ps1 には PowerShell が必要です。pnpm run push:seeker を手動実行してください。"
  exit 1
fi
