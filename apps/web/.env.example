# WordPress REST API（本番 or ローカル Docker）
WORDPRESS_API_URL=http://localhost:8080

# 公開サイト URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 外部 EC（送客先・HTTPS）
NEXT_PUBLIC_SHOP_RAKUTEN=https://www.rakuten.ne.jp/gold/spray/
NEXT_PUBLIC_SHOP_YAHOO=https://store.shopping.yahoo.co.jp/spray/
NEXT_PUBLIC_SHOP_OFFICIAL=https://www.spray166.shop/
# 旧名（Vercel に残っていても動作）: NEXT_PUBLIC_SHOP_GMO

# 任意: プレビュー用シークレット
# PREVIEW_SECRET=

# 英語ショップ運用ページ（/en/products/ops）のパスワード。未設定時は誰でも閲覧可
# SHOP_OPS_SECRET=your-secret-here

# Shopify Dawn POC — false で /en/products 系を非表示
# NEXT_PUBLIC_INBOUND_SHOPIFY_POC=false
