{
  "name": "@spray/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "fetch-catalogs": "node scripts/fetch-category-catalog.mjs --all --images",
    "fetch-catalogs:quick": "node scripts/fetch-category-catalog.mjs --all"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^15.5.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.0",
    "eslint-config-next": "^15.5.24",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}